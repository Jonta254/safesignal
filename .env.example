# Public canonical site origin used for metadata only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# local-preview | cloud-preview | monitored-production
# monitored-production fails closed until all required server services are configured.
SAFESIGNAL_PRODUCT_MODE=local-preview

# Optional waitlist forwarding endpoint. HTTPS is required in production.
WAITLIST_WEBHOOK_URL=

# Future cloud-mode server-only configuration. Do not use NEXT_PUBLIC_ prefixes.
DATABASE_URL=
AUTH_PROVIDER_SECRET=
NOTIFICATION_PROVIDER=
NOTIFICATION_PROVIDER_SECRET=
QUEUE_SIGNING_SECRET=
